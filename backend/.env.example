NODE_ENV=production
PORT=5000
# The public site URL. This one app serves both the website and the /api routes.
FRONTEND_URL=https://vrmsuliva.online

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=portfolio_db

# Use at least 32 random characters. Never commit the real value.
JWT_SECRET=
SESSION_TTL_MINUTES=120

# Only used to create the first administrator when the users table is empty.
ADMIN_NAME=Van Rodolf M. Suliva
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional TOTP MFA. Leave blank until the secret is enrolled in an app.
ADMIN_MFA_SECRET=
MFA_ISSUER=VRMS Portfolio

# Keeps current media URLs working. Use a persistent Hostinger path only after
# copying and verifying all existing media there. Blank means
# backend/public/static/images, which Hostinger replaces on every deploy, so
# admin uploads that are not committed to git are lost. For a persistent path,
# use an absolute folder outside the deploy directory, for example
# /home/<hostinger-user>/portfolio-media.
MEDIA_ROOT=

