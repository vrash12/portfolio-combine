NODE_ENV=production
PORT=5000
FRONTEND_URL=https://vrmsuliva.online

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=portfolio_db

# Generate a cryptographically random value containing at least 32 characters.
JWT_SECRET=
SESSION_TTL_MINUTES=120

# Required only when the users table is empty and the first admin is created.
ADMIN_NAME=Van Rodolf M. Suliva
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional TOTP MFA. Run `npm run mfa:generate`, enroll the URI in an
# authenticator app, and place the generated base32 secret here.
ADMIN_MFA_SECRET=
MFA_ISSUER=VRMS Portfolio
